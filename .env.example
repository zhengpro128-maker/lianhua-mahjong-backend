# WakuDemo OAuth 2.0 + PKCE
# 审核通过后填写；不要把真实 Client ID 以外的凭据提交到仓库。
WAKUDEMO_CLIENT_ID=
WAKUDEMO_BASE_URL=https://wakudemo.cn
WAKUDEMO_REDIRECT_URI=https://www.bestguo.top:58000/api/login/callback
WAKUDEMO_FRONTEND_URL=https://lianhuaguangdongmahjong.guoguo-labs.online/
WAKUDEMO_SCOPE=account.read
WAKUDEMO_TIMEOUT_SECONDS=10
WAKUDEMO_PENDING_TTL_SECONDS=600
WAKUDEMO_TOKEN_TTL_SECONDS=3600
WAKUDEMO_MAX_SESSION_TTL_SECONDS=86400
WAKUDEMO_MAX_PENDING=1024
WAKUDEMO_LOGIN_RATE_LIMIT_PER_MINUTE=30

# 前后端跨站部署使用 None + Secure；本地 HTTP 联调改为 lax + false。
WAKUDEMO_COOKIE_NAME=lgm_wakudemo_session
WAKUDEMO_TRANSACTION_COOKIE_NAME=lgm_wakudemo_oauth_tx
WAKUDEMO_COOKIE_SAMESITE=none
WAKUDEMO_COOKIE_SECURE=true
# 仅本地开发联调：无真实会话时按客户端 playerId 推导测试身份，绕过 OAuth 登录。
# 生产环境严禁开启（联机鉴权会完全失效）。
WAKUDEMO_LOGIN_BYPASS=false

# 微信小游戏登录。WECHAT_TOKEN_SECRET 请使用至少 32 字节的独立随机值，
# 不要与 AppSecret 相同，也不要提交真实值。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN_SECRET=
WECHAT_TOKEN_TTL_SECONDS=604800
WECHAT_AUTH_TIMEOUT_SECONDS=10
WECHAT_LOGIN_RATE_LIMIT_PER_MINUTE=30
