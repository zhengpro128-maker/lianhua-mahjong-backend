# WakuDemo OAuth 2.0 + PKCE
# 审核通过后填写；不要把真实 Client ID 以外的凭据提交到仓库。
WAKUDEMO_CLIENT_ID=
WAKUDEMO_BASE_URL=https://请替换为-wakudemo-平台域名
WAKUDEMO_REDIRECT_URI=https://www.bestguo.top:58000/api/login/callback
WAKUDEMO_FRONTEND_URL=https://lianhuaguangdongmahjong.guoguo-labs.online/
WAKUDEMO_SCOPE=account.read
WAKUDEMO_TIMEOUT_SECONDS=10
WAKUDEMO_PENDING_TTL_SECONDS=600
WAKUDEMO_TOKEN_TTL_SECONDS=3600

# 前后端跨站部署使用 None + Secure；本地 HTTP 联调改为 lax + false。
WAKUDEMO_COOKIE_NAME=lgm_wakudemo_session
WAKUDEMO_COOKIE_SAMESITE=none
WAKUDEMO_COOKIE_SECURE=true
